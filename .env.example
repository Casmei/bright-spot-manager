# Google Maps: chave do navegador (embutida no build) e chave do servidor (sem restrição de referer)
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Banco local (docker-compose.dev.yml)
DATABASE_URL=postgres://vigia:vigia@127.0.0.1:5433/vigia

# docker compose (produção): só letras e números
POSTGRES_PASSWORD=

# "Me afeta também": segredo do hash do IP (obrigatório em produção) e limite de marcas por rede em cada denúncia
AFFECTED_IP_SECRET=
AFFECTED_MAX_PER_IP=3
